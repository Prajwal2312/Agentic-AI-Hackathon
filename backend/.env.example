# PRIVESCAN AI - Environment Configuration

# Application settings
APP_NAME="PRIVESCAN AI"
APP_VERSION="1.0.0"
DEBUG=True

# SQLite Database (can be pointed to postgresql://user:password@localhost:5432/privescan)
DATABASE_URL="sqlite:///./backend/storage/privescan.db"

# Gemini API Configuration
# Optional: If not provided, PRIVESCAN AI automatically uses the deterministic contextual rule engine
# ensuring 100% reliable local demonstrations without API limits or network blocks.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
LLM_PROVIDER="gemini"

# Privacy Thresholds
CONFIRMATION_THRESHOLD=0.85
AMBIGUOUS_THRESHOLD=0.50
MAX_FILE_SIZE_MB=50
