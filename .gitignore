# =====================================================================
# PRIVESCAN AI - Git Ignore
# Protects sensitive user documents, keys, database files, and build artifacts
# =====================================================================

# Environment variables & secrets
.env
*.env
backend/.env
frontend/.env
*.pem
*.key

# Database files
*.db
*.sqlite
*.sqlite3
backend/storage/*.db
backend/storage/privescan.db

# Storage folders containing uploaded personal documents & audit reports
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/remediated/*
!backend/storage/remediated/.gitkeep
backend/storage/reports/*
!backend/storage/reports/.gitkeep

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# Node.js & Next.js artifacts
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# TypeScript
*.tsbuildinfo
frontend/next-env.d.ts

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
